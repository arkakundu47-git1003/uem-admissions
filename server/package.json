{
  "name": "admission-portal-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the University Admission Portal (Express + MongoDB)",
 "scripts": {
  "check": "node --check src/server.js",
  "seed": "node src/seed.js",
  "backup": "node scripts/backup.js",
  "backup:verify": "node scripts/backup.js --verify",
  "restore": "node scripts/restore.js",
  "dev": "node --watch src/server.js",
  "start": "node src/server.js",
  "loadtest": "node loadtest/loadtest.js",
  "loadtest:cleanup": "node loadtest/cleanup.js",
  "test": "vitest run"
},
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
